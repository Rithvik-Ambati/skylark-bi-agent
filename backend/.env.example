# --- monday.com credentials ---
# Generate at: your-account.monday.com -> profile picture -> Developers -> My Access Tokens
MONDAY_API_TOKEN=paste_your_personal_monday_api_token_here

# Board IDs are the numbers in the URL when you open each board:
# https://your-account.monday.com/boards/1234567890
MONDAY_DEALS_BOARD_ID=paste_deals_board_id_here
MONDAY_WORK_ORDERS_BOARD_ID=paste_work_orders_board_id_here

# --- LLM credentials ---
# Get from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_WORKSPACE_ID=paste_your_workspace_id_here

# --- App config ---
# Any random string, used to sign/identify chat sessions server-side
APP_SECRET=change_this_to_any_random_string
